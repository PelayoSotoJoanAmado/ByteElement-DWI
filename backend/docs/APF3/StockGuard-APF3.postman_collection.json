            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{usuarioAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta valida\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"tokenAdmin\",pm.response.json().accessToken);"
