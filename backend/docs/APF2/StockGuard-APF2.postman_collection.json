{
  "info": {
    "name": "StockGuard APF2 mínimo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en base de exposición con perfil demo. Crea producto QA, movimientos, conteo y corte. Definir contraseñas localmente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUsername",
      "value": "administrador"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "jwt-invalido"
    }
  ],
  "item": [
    {
      "name": "01 Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{adminUsername}}\", \"password\": \"{{adminPassword}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login supervisor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"demo-supervisor\", \"password\": \"{{demoPassword}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"supervisorToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login almacen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"demo-almacen\", \"password\": \"{{demoPassword}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"almacenToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Sin token se rechaza",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 JWT inválido se rechaza",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{invalidToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Almacén no administra usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Catálogo de almacenes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/almacenes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const a=pm.response.json();",
              "pm.collectionVariables.set('origenId',a.find(x=>x.codigo==='A01').id);",
              "pm.collectionVariables.set('destinoId',a.find(x=>x.codigo==='A02').id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Crear producto QA no crítico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"QA-{{$guid}}\", \"categoria\": \"RAM\", \"marca\": \"QA\", \"modelo\": \"Test\", \"especificacion\": \"Prueba APF2\", \"critico\": false}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"productoId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Entrada autenticada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"productoId\": \"{{productoId}}\", \"almacenId\": \"{{origenId}}\", \"tipo\": \"ENTRADA\", \"cantidad\": 10, \"motivo\": \"Entrada QA APF2\", \"autor\": \"Suplantación ignorada\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Autor autenticado\",()=>pm.expect(pm.response.json().autor).to.eql(\"demo-almacen\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Otro rol no registra movimientos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/movimientos",
        "body": {
          "mode": "raw",
          "raw": "{\"productoId\": \"{{productoId}}\", \"almacenId\": \"{{origenId}}\", \"tipo\": \"ENTRADA\", \"cantidad\": 1, \"motivo\": \"Permiso denegado\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Transferencia persistente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/transferencias",
        "body": {
          "mode": "raw",
          "raw": "{\"productoId\": \"{{productoId}}\", \"origenAlmacenId\": \"{{origenId}}\", \"destinoAlmacenId\": \"{{destinoId}}\", \"cantidad\": 4, \"motivo\": \"QA transferencia\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ambos saldos\",()=>{pm.expect(pm.response.json().saldoOrigenResultante).to.eql(6);pm.expect(pm.response.json().saldoDestinoResultante).to.eql(4);});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Consulta saldo origen",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/existencias?productoId={{productoId}}&almacenId={{origenId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Saldo 6\",()=>pm.expect(pm.response.json().cantidad).to.eql(6));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Consulta saldo destino",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/existencias?productoId={{productoId}}&almacenId={{destinoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Saldo 4\",()=>pm.expect(pm.response.json().cantidad).to.eql(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 JPQL movimientos paginados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/movimientos?productoId={{productoId}}&pagina=0&tamanio=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tres movimientos\",()=>pm.expect(pm.response.json().totalElements).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Conteo físico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/conteos",
        "body": {
          "mode": "raw",
          "raw": "{\"productoId\": \"{{productoId}}\", \"almacenId\": \"{{origenId}}\", \"cantidadFisica\": 5, \"motivo\": \"Conteo QA APF2\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"conteoId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Confirmar ajuste supervisor",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/conteos/{{conteoId}}/confirmar",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Confirmado y trazable\",()=>{pm.expect(pm.response.json().confirmado).to.eql(true);pm.expect(pm.response.json().movimientoId).to.be.a(\"number\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Segunda confirmación rechazada",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/conteos/{{conteoId}}/confirmar",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Generar corte de cierre",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/cortes-stock",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('desde',new Date(Date.now()-86400000).toISOString());",
              "pm.collectionVariables.set('hasta',new Date(Date.now()+1000).toISOString());"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Indicador I05",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/indicadores?codigo=I05&desde={{desde}}&hasta={{hasta}}&sku=DEMO-RAM",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Denominador visible\",()=>pm.expect(pm.response.json()).to.have.property(\"denominador\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Indicador I07",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/indicadores?codigo=I07&desde={{desde}}&hasta={{hasta}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Denominador visible\",()=>pm.expect(pm.response.json()).to.have.property(\"denominador\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Indicador I10",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/indicadores?codigo=I10&desde={{desde}}&hasta={{hasta}}&sku=DEMO-RAM",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Denominador visible\",()=>pm.expect(pm.response.json()).to.have.property(\"denominador\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Rotación JPQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/reportes/rotacion?desde={{desde}}&hasta={{hasta}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{almacenToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Stock crítico al corte",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/reportes/stock-critico?desde={{desde}}&hasta={{hasta}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
