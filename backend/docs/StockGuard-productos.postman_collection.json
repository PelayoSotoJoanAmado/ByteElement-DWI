{
  "info": {
    "name": "StockGuard - Productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Crea un producto de prueba persistente por ejecución. Backend local sin seguridad todavía."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "skuPrueba",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \" {{skuPrueba}} \",\n  \"categoria\": \"Memorias RAM\",\n  \"marca\": \"Kingston\",\n  \"modelo\": \"DDR4 8 GB\",\n  \"especificacion\": \"DDR4, 8 GB, 3200 MHz\",\n  \"critico\": true\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"skuPrueba\", \"QA-\" + pm.variables.replaceIn(\"{{$guid}}\").toUpperCase());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.collectionVariables.set(\"productoId\", p.id);",
              "pm.test(\"Normalizacion\", () => pm.expect(p.sku).to.eql(pm.collectionVariables.get(\"skuPrueba\")));",
              "pm.test(\"Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/productos/\" + p.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consultar creado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos/{{productoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Mismo ID\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"productoId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 SKU duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \" {{skuPrueba}} \",\n  \"categoria\": \"Memorias RAM\",\n  \"marca\": \"Kingston\",\n  \"modelo\": \"DDR4 8 GB\",\n  \"especificacion\": \"DDR4, 8 GB, 3200 MHz\",\n  \"critico\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Listar paginado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos?pagina=0&tamanio=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Datos invalidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \" \",\n  \"categoria\": \"Memorias RAM\",\n  \"marca\": \"Kingston\",\n  \"modelo\": \"DDR4 8 GB\",\n  \"especificacion\": \"DDR4, 8 GB, 3200 MHz\",\n  \"critico\": null\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Pagina invalida",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos?pagina=-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Tamano excesivo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos?tamanio=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 JSON malformado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
